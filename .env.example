# Required for API server (packages/api / Cloudflare Worker)
TWITTER_BEARER_TOKEN=Bearer YOUR_TOKEN_HERE

# Optional for CLI (packages/cli) - defaults to public web client token
# TWITTER_BEARER_TOKEN=Bearer YOUR_TOKEN_HERE

# Optional: API base URL for WebUI local dev override (packages/web)
# VITE_API_BASE_URL=http://localhost:8000

# Cloudflare deploy (GitHub Actions secrets)
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ACCOUNT_ID=...
