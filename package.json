{
  "name": "twitter-movie-downloader",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "test": "bun test",
    "test:shared": "bun test packages/shared",
    "test:api": "bun test packages/api",
    "test:e2e": "bun run build:cf",
    "tw": "bun packages/cli/mod.ts",
    "dev:api": "bun --watch packages/api/mod.ts",
    "dev:web": "bun run --cwd packages/web dev",
    "build:web": "bun run --cwd packages/web build",
    "build:cf": "bun run build:web && bun packages/web/prepare-cloudflare-dist.ts",
    "preview:web": "bun run --cwd packages/web preview",
    "dev:worker": "wrangler dev",
    "deploy:cf": "bun run build:cf && wrangler deploy",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "ci:local": "vp check && bun test",
    "ci:deps": "vp fmt --check && vp lint && bun test && bun run test:e2e"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@vitejs/plugin-vue": "^6.0.9",
    "fast-check": "4.10.2",
    "typescript": "^5.9.3",
    "vite-plus": "^1.0.0",
    "wrangler": "^4.142.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vitest": "5.0.3"
  },
  "packageManager": "bun@1.4.4"
}
