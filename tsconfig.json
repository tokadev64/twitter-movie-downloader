{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "vite.config.ts",
    "packages/**/*.ts",
    "packages/**/*.vue",
    "e2e/**/*.ts",
    ".cursor/hooks/**/*.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**", ".devbox"]
}
